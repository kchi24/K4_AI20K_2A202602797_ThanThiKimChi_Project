# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# For a model proxy on the Windows host while PaceWise runs in Docker, use:
# OPENAI_BASE_URL=http://host.docker.internal:20128/v1
MODEL_NAME=cx/gpt-5.6-luna
SEMANTIC_SAFETY_MODE=signals
RAG_SCORE_THRESHOLD=0.72
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=800
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql+psycopg://pacewise:change-me@localhost:5433/pacewise
PACEWISE_DB_PASSWORD=change-me
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
VECTOR_STORE_TYPE=qdrant
# Docker Compose overrides this with http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Embedded fallback for minimal local/test runs when QDRANT_URL is empty.
QDRANT_PATH=./data/qdrant
EMBEDDING_CACHE_DIR=./data/models/fastembed
RERANKER_CACHE_DIR=./data/models/flashrank

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
INSTITUTION_ID=university-x
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# ---- Canvas LMS simulator integration ----
LMS_BASE_URL=http://127.0.0.1:8010
# Must match lms-simulator/.env. Never expose this value to Vite/the browser.
PACEWISE_API_KEY=replace-with-a-long-random-service-key
# Signs one-time launch tokens created by the LMS simulator (at least 32 characters).
PACEWISE_LAUNCH_SECRET=replace-with-a-unique-random-launch-secret
# Public browser URL used in the launch link.
PACEWISE_URL=http://localhost:5173
# Production alternative: mount a secret and set only the corresponding *_FILE path.
# PACEWISE_API_KEY_FILE=/run/secrets/pacewise_api_key
# Use a unique random value (at least 32 chars); required and non-default in production.
PACEWISE_SESSION_SECRET=replace-with-a-unique-random-session-secret
# PACEWISE_SESSION_SECRET_FILE=/run/secrets/pacewise_session_secret
PACEWISE_SESSION_MINUTES=240
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=600
LMS_SYNC_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=100
# Set true behind a TLS reverse proxy in production.
FORCE_HTTPS=false

# ---- Google Calendar (optional MVP integration) ----
# Create a Web application OAuth client in Google Cloud and register exactly:
# http://localhost:8000/api/v1/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:5173/#/settings

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# The Docker frontend uses the same origin and proxies /api to the backend.
VITE_API_URL=/api/v1
# Browser-facing LMS URL used by the "Quay lại LMS" action.
VITE_LMS_URL=http://localhost:8010
